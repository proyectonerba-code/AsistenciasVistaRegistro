# ============================================================
# Control de Asistencia — Vista de Registro (pública)
# Copia este archivo a .env.local y configura la variable.
# Nunca subas .env.local al repositorio.
# ============================================================

# URL del backend (ej. https://asistencias-backend.vercel.app)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Dominio de esta misma app (se usa para mostrar la URL del token)
NEXT_PUBLIC_REGISTRO_URL=http://localhost:3000
