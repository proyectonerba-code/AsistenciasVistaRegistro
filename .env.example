# ============================================================
# Control de Asistencia — Vista Unificada (pública + admin)
# Copia este archivo a .env.local y configura las variables.
# Nunca subas .env.local al repositorio.
# ============================================================

# URL del backend (ej. https://asistencias-backend.proyectonerba.workers.dev)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Dominio de esta misma app (se usa para mostrar la URL del token)
NEXT_PUBLIC_REGISTRO_URL=http://localhost:3000

# --- Supabase (para el panel de admin integrado) ---
# URL del proyecto de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Llave pública (anon) de Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Llave de service role (SOLO servidor, nunca al navegador)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# URL de Supabase (para el servidor, puede ser la misma que NEXT_PUBLIC_SUPABASE_URL)
SUPABASE_URL=https://tu-proyecto.supabase.co
